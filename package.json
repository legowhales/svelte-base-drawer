{
	"name": "svelte-base-drawer",
	"version": "0.2.2",
	"description": "Drawer component for Svelte 5 — a port of Base UI's Drawer built on bits-ui Dialog. Swipe to dismiss, snap points, nested drawers, swipe to open, virtual keyboard support.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/legowhales/svelte-base-drawer.git"
	},
	"homepage": "https://svelte-base-drawer.otarie.dev",
	"bugs": "https://github.com/legowhales/svelte-base-drawer/issues",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./drawer.css": "./dist/drawer/drawer.css"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"keywords": [
		"svelte",
		"svelte5",
		"drawer",
		"bottom-sheet",
		"sheet",
		"dialog",
		"base-ui",
		"bits-ui",
		"swipe",
		"snap-points",
		"mobile"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepack": "npm run package",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"peerDependencies": {
		"bits-ui": "^2.18.1",
		"svelte": "^5.0.0"
	},
	"overrides": {
		"cookie": "^0.7.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"bits-ui": "^2.18.1",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"publint": "^0.3.21",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"vite": "^8.1.4"
	}
}
